# 复制为 .env 并按需修改;生产环境的敏感值必须通过环境变量/Secret 注入

# 数据库连接:本地默认 SQLite 零配置;生产切换 MySQL
# DATABASE_URL=mysql+pymysql://potato:potato@mysql:3306/potato?charset=utf8mb4
DATABASE_URL=sqlite:///./potato.db

# JWT 密钥:生产必须替换为 32 字节以上强随机值(可用 python3 -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_DAYS=7

# 允许的前端来源(逗号分隔);生产改为正式域名,禁止 *
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# dev / prod
APP_ENV=dev