# 后端镜像:Python 3.11 + uvicorn
#
# 按课程《后端部署》手册的要求:
#   Python 3.11 / WORKDIR /app / 使用 SECoder PyPI 镜像 / 监听 80 端口 / 由 start.sh 启动
# 构建上下文为**仓库根目录**(CI: BUILDKIT_CONTEXT=. 、BUILDKIT_DOCKERFILE_DIR=deploy)。
FROM python:3.11-slim

WORKDIR /app

# 先装依赖以利用构建缓存。使用 SECoder PyPI 镜像(手册要求)。
COPY backend/requirements.txt .
RUN pip install --no-cache-dir \
    -i https://pypi.t.secoder.net/+simple \
    -r requirements.txt

COPY backend/app ./app
COPY backend/start.sh ./start.sh
COPY backend/.env.example .env.example
RUN chmod +x ./start.sh

# Service 的 targetPort 是命名端口 http,指向容器 80
EXPOSE 80
CMD ["./start.sh"]
